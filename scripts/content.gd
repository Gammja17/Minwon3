## 햇살동 이야기: 동네 게시판 글 [제목, 내용]. 내가 한 일이 여기 올라온다.
static func board_posts(day: int, flags: Dictionary) -> Array:
	var out: Array = []
	if flags.get("haneul_ok", false):
		out.append(["3번 창구 덕분에 원서 냈어요", "신분증 두고 왔는데 지문으로 확인해 주셨어요. 5시 58분에 원서 냄. 진짜 감사합니다!"])
	if flags.get("haneul_missed", false):
		out.append(["신분증 없다고 그냥 돌려보내네요", "지문으로도 된다던데... 원서 못 냈습니다."])
	if flags.get("doyun_done", false):
		out.append(["우리 애가 혼자 등본 떼러 갔는데", "창구에서 저한테 전화를 주셨어요. 퇴근길에 들렀더니 애가 신났더라고요."])
	if flags.get("dalsu_ejected", false):
		out.append(["주민센터에서 노인을 내쫓았다네요", "박달수 할아버지가 국민신문고에 올렸대요. 요즘 공무원들 참..."])
	if flags.get("dalsu_done", false):
		out.append(["박달수 할아버지 요즘 달라지셨어요", "주민센터에서 안내 조끼 입고 계시던데요. 인사도 먼저 하세요."])
	if flags.get("jaehyuk_ok", false):
		out.append(["유튜버 영상에 우리 동 나옴", "'생각보다 친절했던 햇살동 3번 창구' ㅋㅋ 댓글 칭찬 많아요."])
	if flags.get("jaehyuk_angry", false):
		out.append(["햇살동 갑질 공무원 영상 보셨어요?", "조회수 3만... 편집이 좀 이상하긴 하던데."])
	if flags.get("minjae_saved", false):
		out.append(["전세 사기 당할 뻔한 썰", "전입이랑 확정일자 같은 날 받으라고 한 주민센터 덕분에 보증금 지켰습니다. 여러분 꼭 같은 날 하세요."])
	if flags.get("minjae_erased", false):
		out.append(["세입자 전입을 집주인이 뺄 수 있나요?", "제 전입이 빠져 있었어요. 누가 뺐는지 아무도 모른대요."])
	if flags.get("scam_caught", false):
		out.append(["인감 도둑 잡혔대요", "할아버지 인감 훔쳐서 대출 받으려던 조카가 주민센터에서 잡혔대요."])
	if flags.get("oksun_found", false):
		out.append(["반찬가게 옆집 할머니 무사하세요", "주민센터에서 복지팀이랑 같이 가 줘서 문을 열었대요. 조금만 늦었어도..."])
	if flags.get("oksun_exposed", false):
		out.append(["빚쟁이가 할머니 집 문에 독촉장을", "9-4 할머니 집에 매일 빨간 종이가 붙어요. 주소는 어떻게 알았을까요."])
	if flags.get("wanted_caught", false):
		out.append(["주민센터에서 수배자 잡힘", "남의 이름으로 신분증 만들던 사람이 3번 창구에서 잡혔대요. 회람 보고 알아봤다고."])
	if flags.get("phishing_stopped", false):
		out.append(["보이스피싱 막아 준 주민센터", "우리 엄마가 검찰 사칭 전화에 속을 뻔했는데 창구 직원분이 112에 신고해 주셨어요."])
	if flags.get("haneul_passed", false):
		out.append(["1차 합격했어요!!", "원서 마감날 신분증 두고 왔던 그 학생입니다. 면접 준비 중이에요."])
	out += [
		["번호표 기계 또 고장인가요?", "아침에 뽑았는데 종이가 안 나와서 두 번 뽑았어요."],
		["주민센터 앞 붕어빵 트럭 왔어요", "팥 3개 천 원. 슈크림은 금방 떨어져요."],
		["주차장 좀 넓혀 주세요", "등본 한 통 떼러 가는데 주차하느라 20분..."],
	]
	var hint: String = STOCK_HINTS.get(day, "")
	if hint != "":
		out.append(["(주식) 이거 진짜예요?", hint])
	return out
